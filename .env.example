# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit real secrets here.

# Anthropic API key, used for AI statement/SMS parsing (get one at https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Model used for parsing. Haiku is cheap and accurate enough for structured
# extraction of many small SMS messages. Bump to claude-sonnet-5 for pickier
# statement parsing if you see mis-parses.
AI_MODEL=claude-haiku-4-5-20251001
